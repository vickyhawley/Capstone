{
  "name": "groundwork",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:core-purity": "node scripts/check-core-purity.mjs",
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:web": "pnpm --filter @groundwork/web dev",
    "dev:api": "pnpm --filter @groundwork/api dev"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "5.7.2"
  }
}
