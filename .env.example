# Copy to .env.local and fill in. Never commit real secrets.
# Each app also has its own .env.example — this file lists variables that
# are shared across the workspace or set at the repo root for tooling.

# ---- Supabase (shared) ----
# Public URL of the Supabase project.
SUPABASE_URL=

# Anon key — safe for client bundles, subject to RLS.
SUPABASE_ANON_KEY=

# Service-role key — server only, bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- LLM provider (Sprint 1+) ----
# One of: openai, anthropic, vercel-gateway. Adapter reads this to choose implementation.
LLM_PROVIDER=

# Provider-specific key. Leave unset until Sprint 1 wires the LanguageModel adapter.
LLM_API_KEY=

# ---- Reranker (Sprint 1 experiment, see docs/adr/0001) ----
# Left blank in the scaffold; the NoopReranker requires no key.
RERANKER_PROVIDER=
RERANKER_API_KEY=

# ---- Upstash Redis (rate limiting, GW-37) ----
# Provisioned via Vercel Marketplace (Upstash free tier). Required in any
# non-development environment or the API refuses to boot.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
