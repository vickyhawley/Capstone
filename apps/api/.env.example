# Copy to .env.local. See root .env.example for shared vars.

PORT=8787

# Upstash Redis for per-IP rate limiting (GW-37).
# Local dev: leave blank — the API runs permit-all and prints a "not
# configured" flag in /health responses.
# Vercel: don't set these here. Add the Upstash Marketplace integration in
# the Vercel dashboard; it injects KV_REST_API_URL/KV_REST_API_TOKEN which
# the code also accepts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
