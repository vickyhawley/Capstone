# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.turbo/
*.tsbuildinfo

# Vite / React
.vite/

# Test / coverage
coverage/
.nyc_output/

# Vercel — .vercel is the CLI's link file, one per project. Each app has
# its own .vercel/ (linked via `vercel link` from inside apps/<name>).
.vercel/

# Supabase local dev
supabase/.branches/
supabase/.temp/

# Ingestion runner output (regenerable; snapshot tests are the source of
# truth for chunk shape, see packages/ingestion/src/*.test.ts).
data/chunks/

# Python (eval harness)
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
# Keep sprint result files committed as evidence, but never local scratch runs
evals/results/sprint-0-smoke/
evals/results/sprint-prep-local/

# Env — never commit
.env
.env.local
.env.*.local

# IDE / OS
.DS_Store
.idea/
.vscode/
*.log
.vercel
.env*
